# ---------------------------------------------------------------------------
# Kodein Klinik — Environment frontend (contoh)
# ---------------------------------------------------------------------------
# Salin menjadi `.env.local` (development) atau `.env.production.local`
# (production build). JANGAN menaruh secret di variabel NEXT_PUBLIC_* —
# semua nilai NEXT_PUBLIC_* ter-embed ke bundle browser.
#
# Dipakai oleh: src/lib/env.ts (satu-satunya pembaca env publik),
#               src/lib/api-client.ts, e2e/*.mjs
# ---------------------------------------------------------------------------

# WAJIB. URL absolut API backend (termasuk prefix /api/v1).
# Build production TANPA nilai ini akan menampilkan error konfigurasi yang
# jelas di UI dan menolak mengirim request (tidak ada fallback localhost).
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Opsional. Metadata build (label environment & versi di UI/diagnostik).
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_GIT_COMMIT=

# ---------------------------------------------------------------------------
# Demo mode — NONAKTIF kecuali diminta eksplisit.
# Default: aktif hanya saat `next dev` (NODE_ENV=development).
# Wajib `false` (atau kosong) pada staging/production.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_DEMO=false

# Password akun demo/seed — HANYA untuk environment demo.
# Tidak ada password default di source; quick-login muncul hanya bila variabel
# ini terisi DAN NEXT_PUBLIC_ENABLE_DEMO=true.
# NEXT_PUBLIC_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Testing (dipakai script E2E / unit test; bukan oleh aplikasi)
# ---------------------------------------------------------------------------
# TEST_API_URL=http://localhost:3000/api/v1
# E2E_BASE_URL=http://localhost:3001
# E2E_API_URL=http://localhost:3000/api/v1
# E2E_GROUP=F2-01,F2-02
# E2E_WORKER=w1
